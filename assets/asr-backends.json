{
  "schema_version": 1,
  "default_backend": null,
  "backends": {
    "assemblyai": {
      "adapter": "assemblyai",
      "base_url": "https://api.assemblyai.com",
      "api_key_env": "ASSEMBLYAI_API_KEY",
      "credential_name": "assemblyai",
      "speech_models": [
        "universal-3-5-pro",
        "universal-2"
      ],
      "language_detection": true,
      "speaker_labels": true,
      "punctuate": true,
      "format_text": true,
      "request_timeout_seconds": 30,
      "upload_timeout_seconds": 300
    },
    "whisperx": {
      "adapter": "whisperx",
      "ssh_host": "your-whisperx-server.example.com",
      "ssh_port": 22,
      "ssh_user": "your-user",
      "ssh_key_file": "~/.ssh/whisperx",
      "ssh_executable": "ssh",
      "remote_port": 8008,
      "api_key_env": "WHISPERX_API_KEY",
      "credential_name": "whisperx",
      "model": "large-v3",
      "compute_type": "float16",
      "batch_size": 16,
      "vad_method": "pyannote",
      "align": true,
      "language": null,
      "request_timeout_seconds": 30,
      "upload_timeout_seconds": 300
    }
  }
}
